      "item": [
        {
          "name": "Create Draft",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "if (!pm.environment.get(\"customerId\") || pm.environment.get(\"customerId\").startsWith(\"demo-\") === false) {\r",
                  "  pm.environment.set(\"customerId\", \"demo-\" + Date.now());\r",
                  "}\r",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();\r",
                  "pm.environment.set(\"orderId\", json.order_id);\r",
                  "\r",
                  "pm.test(\"status is DRAFT\", () => {\r",
                  "  pm.expect(json.status).to.eql(\"DRAFT\");\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
